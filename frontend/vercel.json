# Deploy frontend to Vercel (free): push repo to GitHub, then in Vercel:
# New Project > import repo > Root Directory: frontend > Framework: Vite.
# In Project Settings > Environment Variables set:
#   VITE_API_BASE = https://<your-backend>.onrender.com/api
#
# The app reads VITE_API_BASE at build time (frontend/src/api.js).
# No vercel.json rewrites needed: the backend's CORS_ORIGINS env allows your domain.
{
  "$schema": "https://openapi.vercel.sh/vercel.json"
}
