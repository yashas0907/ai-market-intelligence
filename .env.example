# === LLM provider (leave unset to use the built-in local heuristic synthesizer) ===
# Options: heuristic | openai | anthropic | openai_compatible
# Free real-LLM setup (Groq): console.groq.com -> API Keys -> create key, then:
#   LLM_PROVIDER=openai_compatible
#   LLM_BASE_URL=https://api.groq.com/openai/v1
#   LLM_MODEL=llama-3.3-70b-versatile
#   LLM_API_KEY=gsk_...
LLM_PROVIDER=heuristic
LLM_MODEL=gpt-4o-mini
# LLM_API_KEY=sk-...
# For openai_compatible (Groq, Together, Ollama, vLLM...):
# LLM_BASE_URL=https://api.groq.com/openai/v1

# === Embeddings: local (default, no key) | openai ===
EMBEDDING_PROVIDER=local

# === Database ===
DATABASE_URL=sqlite+aiosqlite:///./market_intel.db

# === Data-source HTTP behavior ===
HTTP_USER_AGENT=AIMarketIntelligence-Edu/1.0 (educational research project)
HTTP_TIMEOUT_SECONDS=20

# === Cache TTLs (seconds) ===
CACHE_MARKET_TTL=900
CACHE_FUNDAMENTALS_TTL=43200
CACHE_NEWS_TTL=1800
CACHE_COMPANY_TTL=86400

# === Research / cost control ===
RESEARCH_DEPTH=standard
RESEARCH_MAX_NEWS_ARTICLES=20
RESEARCH_DEDUP_TTL=3600
RATE_LIMIT_PER_MINUTE=60

# === Security ===
MAX_UPLOAD_SIZE_MB=10
CORS_ORIGINS=["http://localhost:5173"]

# === Logging ===
LOG_LEVEL=INFO
